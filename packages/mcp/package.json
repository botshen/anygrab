{
  "name": "@anygrab/mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol (MCP) server for AnyGrab DOM & UI context distillation.",
  "type": "module",
  "license": "MIT",
  "author": "botshen & AnyGrab Contributors",
  "homepage": "https://github.com/botshen/anygrab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botshen/anygrab.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/botshen/anygrab/issues"
  },
  "bin": {
    "anygrab-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anygrab/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "linkedom": "^0.18.15",
    "zod": "^3.25.0"
  }
}
