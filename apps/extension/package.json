{
  "name": "@anygrab/extension",
  "version": "0.2.0",
  "private": true,
  "description": "AnyGrab Chrome Manifest V3 bilingual visual UI & context picker extension.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/generate-icons.mjs && tsup",
    "dev": "node scripts/generate-icons.mjs && tsup --watch",
    "test": "vitest run --root ../.. apps/extension",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anygrab/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7"
  }
}
