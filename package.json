{
  "name": "anygrab-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Token-budget-aware DOM & UI context distillation engine for AI Coding Agents, Browser-Use, and RAG.",
  "license": "MIT",
  "author": "botshen & AnyGrab Contributors",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @anygrab/core build && pnpm -r --filter '!@anygrab/core' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/verify-all.mjs",
    "typecheck": "pnpm --filter @anygrab/core build && pnpm -r typecheck",
    "bench": "pnpm --filter @anygrab/core build && pnpm --filter @anygrab/benchmarks bench",
    "playground": "pnpm --filter @anygrab/playground dev",
    "playground:preview": "pnpm --filter @anygrab/playground preview",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "prettier": "^3.5.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
